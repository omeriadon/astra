# Run with Astra paused on the main thread in Xcode:
# command source checks/sidebar-backdrop-edge-check.lldb
expression -l objc++ -- @import AppKit; @import Foundation; @import QuartzCore;
expression -l objc++ -O -- ({ NSMutableString *report = [NSMutableString string]; __block int found = 0; __block int valid = 0; __block void (^visit)(NSView *); visit = ^(NSView *view) { if ([NSStringFromClass(view.class) containsString:@"HazeEffectView"] && !NSIsEmptyRect(view.visibleRect)) { found++; NSArray *filters = view.layer.filters; NSObject *filter = filters.firstObject; CGFloat radius = [(NSNumber *)[filter valueForKey:@"inputRadius"] doubleValue]; id mask = [filter valueForKey:@"inputMaskImage"]; BOOL configured = [NSStringFromClass(view.layer.class) isEqualToString:@"CABackdropLayer"] && fabs(view.bounds.size.height - 28) < 0.01 && filters.count == 1 && radius == 8 && mask != nil; valid += configured; [report appendFormat:@"%@: %@, size=%@, radius=%.0f, mask=%@\n", configured ? @"PASS" : @"FAIL", NSStringFromClass(view.layer.class), NSStringFromSize(view.bounds.size), radius, mask ? @"present" : @"missing"]; } for (NSView *child in view.subviews) { visit(child); } }; for (NSWindow *window in NSApp.windows) { if (window.isVisible) { visit(window.contentView); } } visit = nil; [report appendFormat:@"%@: %d/%d visible edge layers configured\n", found >= 2 && valid == found ? @"PASS" : @"FAIL", valid, found]; report; })
