#!/usr/bin/env bash

if ! command -v swiftformat >/dev/null 2>&1; then
    printf '%s\n' 'SwiftFormat is required for this pre-commit hook but was not found in PATH.' >&2
    exit 1
fi

failures=0

while IFS= read -r -d '' path; do
    if ! git show ":$path" | swiftformat --lint --stdinpath "$path"; then
        printf 'SwiftFormat check failed: %s\n' "$path" >&2
        failures=$((failures + 1))
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

if (( failures > 0 )); then
    printf 'SwiftFormat found issues in %d staged Swift file(s).\n' "$failures" >&2
    exit 1
fi
