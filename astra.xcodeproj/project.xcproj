{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/Lakr233/MarkdownView",
      "version": {
        "up-to-next-major-version": "4.1.7",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sindresorhus/Defaults",
      "version": {
        "up-to-next-major-version": "9.0.9",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sindresorhus/DockProgress",
      "version": {
        "up-to-next-major-version": "5.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/heestand-xyz/Noise",
      "version": {
        "up-to-next-major-version": "2.0.5",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/OskarGroth/MaterialView.git",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.10.0",
      },
    }, {
      "kind": "local",
      "path": "Packages/Haze",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "astra",
      "target-membership": [
        "AstraWebsiteAppRuntime",
        "astra",
      ],
      "membership-exceptions": [
        {
          "target": "astra",
          "exclusions": [
            "Special/Info.plist",
          ],
        }, {
          "target": "AstraWebsiteAppRuntime",
          "exclusions": [
            "App/AppDelegate.swift",
            "App/BrowserAuthenticationSessionHandler.swift",
            "App/browserApp.swift",
            "UI/Shell/BrowserWindowController.swift",
            "Extensions/DarkReader-LICENSE.txt",
            "Extensions/SOURCES.txt",
            "Extensions/darkreader-chrome-mv3.zip",
            "Extensions/uBlock-Origin-Lite-LICENSE.txt",
            "Extensions/ublock-origin-lite-safari.zip",
            "Special/Assets.xcassets",
            "Special/Info.plist",
            "Special/astra.icon",
            "Web/Reader/Readability-LICENSE.txt",
            "Web/Reader/Readability-readerable.js",
            "Web/Reader/Readability.js",
            "Web/Reader/Reader.js",
            "App/BrowserDataTransfer.swift",
            "App/BrowserDiagnostics.swift",
            "App/BrowserWebsiteAppMenuIntegration.swift",
            "UI/Content/ContentView.swift",
            "UI/Content/BrowserRootView.swift",
            "UI/Shell/DesktopBrowserShell.swift",
            "UI/Shell/CompactBrowserShell.swift",
            "UI/Shell/BrowserSplitView.swift",
            "UI/Shell/PrivateBrowserSidebar.swift",
            "UI/Shell/BrowserSpacePager.swift",
            "UI/Shell/MiniAstraWindowController.swift",
            "UI/Shell/MiniAstraView.swift",
            "UI/Shell/MiniAstraOpeningAnimation.swift",
            "UI/Tabs/ControlTabSwitcher.swift",
            "UI/Tabs/ControlTabSwitcherPreview.swift",
            "UI/Shell/BrowserSidebarControls.swift",
            "UI/Shell/BrowserDownloadsBarView.swift",
            "UI/Tabs/BrowserTabRow.swift",
            "UI/Tabs/ControlTabSwitcherCandidateView.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "AstraWebsiteAppInstaller", "target-membership": [ "AstraWebsiteAppInstaller" ] },
    { "kind": "folder", "path": "AstraWebsiteAppLoader", "target-membership": [ "AstraWebsiteAppTemplate" ] },
    { "kind": "folder", "path": "AstraWebsiteAppRuntime", "target-membership": [ "AstraWebsiteAppRuntime" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/astra.app", "id": "2A3CB8C8305FC07600584097", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AstraWebsiteAppTemplate.app", "id": "2A7B340630728629002961D5", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "astra/copy/Embed Website App Template", "code-sign-on-copy": true } ] },
        { "path": "<PRODUCTS>/AstraWebsiteAppInstaller.app", "id": "2A7B3EBC3073C646002961D5", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "astra/copy/Embed Website App Template", "code-sign-on-copy": true } ] },
        { "path": "<PRODUCTS>/AstraWebsiteAppRuntime.framework", "id": "2A7B40EA3073C807002961D5", "type": "wrapper.framework", "index": false, "target-membership": [ { "build-phase": "astra/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
